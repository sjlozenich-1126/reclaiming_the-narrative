rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'jscthebrand@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidArticle(data) {
      return data.keys().hasAll([
        'id', 'slug', 'title', 'subtitle', 'abstract', 'body',
        'authorName', 'authorUid', 'imageUrl', 'imageCaption',
        'wayIntoArchive', 'tags', 'readingTimeMinutes',
        'issueNumber', 'displayDate', 'published', 'featured',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'slug', 'title', 'subtitle', 'abstract', 'body',
        'authorName', 'authorUid', 'imageUrl', 'imageCaption',
        'wayIntoArchive', 'tags', 'readingTimeMinutes',
        'issueNumber', 'displayDate', 'sourceDocumentUrl',
        'published', 'featured', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9\\-]+$')
      && data.title is string && data.title.size() >= 3 && data.title.size() <= 300
      && data.subtitle is string && data.subtitle.size() <= 500
      && data.abstract is string && data.abstract.size() >= 10 && data.abstract.size() <= 2000
      && data.body is string && data.body.size() >= 20 && data.body.size() <= 100000
      && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
      && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
      && data.imageUrl is string && data.imageUrl.size() <= 450000
      && data.imageCaption is string && data.imageCaption.size() <= 400
      && data.wayIntoArchive in ['lived-experience', 'mechanisms', 'counter-archive']
      && data.tags is list && data.tags.size() <= 10
      && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 64))
      && data.readingTimeMinutes is int && data.readingTimeMinutes >= 1 && data.readingTimeMinutes <= 240
      && data.issueNumber is string && data.issueNumber.size() >= 1 && data.issueNumber.size() <= 60
      && data.displayDate is string && data.displayDate.size() >= 1 && data.displayDate.size() <= 40
      && (!('sourceDocumentUrl' in data) || (data.sourceDocumentUrl is string && data.sourceDocumentUrl.size() <= 300))
      && data.published is bool
      && data.featured is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidTag(data) {
      return data.keys().hasAll([
        'id', 'name', 'slug', 'description', 'category', 'createdByUid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'name', 'slug', 'description', 'category', 'createdByUid', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.name is string && data.name.size() >= 2 && data.name.size() <= 64
      && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 64 && data.slug.matches('^[a-z0-9\\-]+$')
      && data.description is string && data.description.size() <= 300
      && data.category in ['Psychoanalytic', 'Legal & Statutory', 'Systems & Data', 'Archival Method']
      && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'name', 'frequency', 'createdAt'])
      && data.keys().hasOnly(['email', 'name', 'frequency', 'createdAt'])
      && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
      && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
      && data.name is string && data.name.size() <= 120
      && data.frequency in ['dispatches', 'monographs', 'all']
      && data.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'createdAt'])
      && data.keys().hasOnly(['uid', 'email', 'name', 'createdAt'])
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
      && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    match /articles/{articleId} {
      allow get: if isValidId(articleId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();
      allow create: if isValidId(articleId)
        && isAdmin()
        && isValidArticle(incoming())
        && incoming().id == articleId
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(articleId)
        && isAdmin()
        && isValidArticle(incoming())
        && incoming().id == existing().id
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'subtitle', 'abstract', 'body', 'authorName',
          'imageUrl', 'imageCaption', 'wayIntoArchive', 'tags',
          'readingTimeMinutes', 'issueNumber', 'displayDate',
          'sourceDocumentUrl', 'published', 'featured', 'updatedAt'
        ]);
      allow delete: if isValidId(articleId) && isAdmin();
    }

    match /tags/{tagId} {
      allow get: if isValidId(tagId);
      allow list: if true;
      allow create: if isValidId(tagId)
        && isAdmin()
        && isValidTag(incoming())
        && incoming().id == tagId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(tagId)
        && isAdmin()
        && isValidTag(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'description', 'category', 'updatedAt'
        ]);
      allow delete: if isValidId(tagId) && isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow get: if isValidId(subscriberId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(subscriberId)
        && isValidSubscriber(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(subscriberId)
        && isAdmin()
        && isValidSubscriber(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name', 'frequency']);
      allow delete: if isValidId(subscriberId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(adminId)
        && isAdmin()
        && isValidAdminUser(incoming())
        && incoming().uid == adminId
        && incoming().createdAt == request.time;
      allow update: if isValidId(adminId)
        && isAdmin()
        && isValidAdminUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name']);
      allow delete: if isValidId(adminId) && isAdmin();
    }
  }
}
